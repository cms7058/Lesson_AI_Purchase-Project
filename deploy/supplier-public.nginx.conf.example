# Public supplier-only gateway template, NOT an active deployment.
# Management UI/API must remain internal or behind staff authentication.
limit_req_zone $binary_remote_addr zone=supplier_login:10m rate=5r/m;
server {
    listen 443 ssl;
    server_name supplier.example.com;
    ssl_certificate /replace/fullchain.pem;
    ssl_certificate_key /replace/privkey.pem;
    root /replace/apps/web/dist;
    client_max_body_size 11m;

    location = /supplier { try_files /index.html =404; }
    location /js/ { try_files $uri =404; }
    location /css/ { try_files $uri =404; }
    location /fonts/ { try_files $uri =404; }
    location /img/ { try_files $uri =404; }
    location = /api/v1/supplier/login {
        limit_req zone=supplier_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Role "";
        proxy_set_header Authorization $http_authorization;
    }
    location /api/v1/supplier/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header X-User-Id "";
        proxy_set_header X-User-Role "";
        proxy_set_header Authorization $http_authorization;
    }
    location / { return 404; }
}

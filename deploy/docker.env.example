# Copy to .env.docker; use a random hex password (URL-safe), never commit it.
POSTGRES_PASSWORD=
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8080
WEB_ORIGINS=http://localhost:8080
IMAGE_TAG=local
SEED_DEMO_DATA=true
# Optional stable Fernet key for encrypted SMTP credentials; otherwise /data stores one.
AI_ASSIST_SECRET_KEY=
# Optional MinerU fallback. A database connector of type MinerU takes priority.
MINERU_BASE_URL=
MINERU_API_KEY=
MINERU_BACKEND=pipeline
MINERU_TIMEOUT_SECONDS=120
LLM_PROVIDER=disabled
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
